[% SET footerjs = 1 %]
[% INCLUDE 'doc-head-open.inc' %]
<title>NM2DB Keyword Search</title>
[% INCLUDE 'doc-head-close.inc' %]
</head>
<body id="tools_plugins" class="tools">
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'prefs-admin-search.inc' %]
[% END %]

<div id="breadcrumbs">
    <a href="/cgi-bin/koha/mainpage.pl">Home</a>
    &rsaquo; <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
    &rsaquo; NM2DB Keyword Search
</div>

<div class="main container-fluid">
    <div class="row">
        <div class="col-sm-12">
            <main>
                <h1>NM2DB Keyword Search</h1>
                <div class="page-section">
                    <h2>Search cache maintenance</h2>
                    [% IF refresh_error %]
                        <div class="dialog alert">Could not start the cache refresh. Please check the Koha logs.</div>
                    [% END %]
                    <form method="post" action="/cgi-bin/koha/plugins/run.pl">
                        [% INCLUDE 'csrf-token.inc' %]
                        <input type="hidden" name="class" value="[% CLASS | html %]">
                        <input type="hidden" name="method" value="tool">
                        <input type="hidden" name="op" value="cud-refresh-cache">
                        <p>Rebuild keyword weights, facets, suggestions and the word index from normalized MARC. This also resets bibliographic facet mappings to Koha's Zebra-style facet configuration; catalogue records are not changed.</p>
                        <button type="submit" class="btn btn-default">Refresh search caches</button>
                        <p>The refresh runs as a Koha background job and may take several minutes. Follow its status on the job details page.</p>
                    </form>
                </div>
            </main>
        </div>
    </div>
</div>

[% MACRO jsinclude BLOCK %][% END %]
[% INCLUDE 'intranet-bottom.inc' %]
